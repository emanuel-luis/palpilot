# Cloud Run image for the coordinator: serves the built console (static assets +
# SPA fallback) AND the API from one origin, so there is no CORS to configure and
# the bearer-token model is unchanged.
#
# The 1100-line router in main.py is reused verbatim: functions_framework's
# create_app() wraps the same `coordinator(request)` entry point the Cloud
# Function used, so this migration changes the hosting, not the handler.
#
# Two stages: the builder installs the hash-pinned lock into a venv, the runtime
# copies only that venv and the app. Both FROM lines carry the same literal tag + digest
# (no ARG) so Dependabot can bump them; keep them identical so the venv's ABI matches.


FROM python:3.12-slim@sha256:aa943ce411423c7582288f18707ff66eddcbaeb510502d747a72aeb34f30d159 AS builder
ENV PIP_NO_CACHE_DIR=1 PIP_DISABLE_PIP_VERSION_CHECK=1
RUN python -m venv /opt/venv
COPY requirements.lock /tmp/requirements.lock
# requirements.lock is generated by `make lock` (uv pip compile --generate-hashes);
# --require-hashes refuses anything unpinned or unhashed.
RUN /opt/venv/bin/pip install --require-hashes -r /tmp/requirements.lock

FROM python:3.12-slim@sha256:aa943ce411423c7582288f18707ff66eddcbaeb510502d747a72aeb34f30d159
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PATH=/opt/venv/bin:$PATH

# Fixed UID so the container user is stable and checkable.
RUN useradd --uid 10001 --no-create-home --shell /usr/sbin/nologin app

WORKDIR /app
COPY --from=builder /opt/venv /opt/venv

# index.html + assets/ are produced by `npm run build` in ../frontend and land
# here, so the image carries the console it serves. They are not committed.
COPY main.py discord_bot.py index.html ./
COPY assets ./assets
# Fail the build (not the first request) if the upload lacked the built console.
RUN test -f index.html && test -d assets

USER 10001

ENV PORT=8080
EXPOSE 8080

# Cloud Run ignores Docker HEALTHCHECK (it probes the port itself); this is for
# local `docker run` and CI. Any HTTP response from / means the app is serving.
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD ["python", "-c", "import os, urllib.request; urllib.request.urlopen('http://127.0.0.1:' + os.environ.get('PORT', '8080') + '/', timeout=4)"]

# One worker, several threads: the module keeps in-process state (login throttle,
# the 10s GCS document cache), so extra workers would each hold a separate copy.
# timeout 0 because a proxied save activate/restore legitimately runs for minutes;
# Cloud Run's own request timeout is the real ceiling.
CMD exec gunicorn \
    --bind ":${PORT}" \
    --workers 1 \
    --threads 8 \
    --timeout 0 \
    --access-logfile - \
    "functions_framework:create_app('coordinator', 'main.py', 'http')"
