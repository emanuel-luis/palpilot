# Copy to terraform.tfvars and fill in. NEVER commit terraform.tfvars
# (it holds plaintext secrets and is gitignored). Keep it out of any
# cloud-synced folder, or use a remote state backend.

# --- required ---
project_id = "your-gcp-project-id"
region     = "southamerica-east1"
zone       = "southamerica-east1-a"

# --- credentials (choose strong values) ---
panel_password = "CHANGE-ME-panel-login"      # admin panel login
admin_password = "CHANGE-ME-palworld-admin"   # Palworld REST/in-game admin password
internal_token = "CHANGE-ME-random-hex"       # shared secret: watchdog + coordinator->panel RBAC signing

# --- Steam account for game downloads (optional; empty = anonymous) ---
# Anonymous downloads are rate-limited per account/IP and that account is shared
# by everyone, so Steam can refuse ('Access Denied' on a manifest request code)
# and strand the server on an old build. A real account that owns Palworld lifts
# that. Applying these is an in-place metadata update (no VM recreate); then
# finish the sign-in once in the console under "Game version" -- Steam Guard
# wants a code per new machine, and steamcmd caches the session afterwards.
# Prefer a dedicated Steam account: metadata is readable by anyone with
# compute.instances.get on the project (same as the passwords above).
# steam_login_user     = ""
# steam_login_password = ""

# --- optional (defaults shown) ---
# panel_port         = 8080
# panel_user         = "admin"
# rest_api_port      = 8212
# idle_poll_seconds  = 60      # how often the watchdog checks for players
# idle_grace_seconds = 1800    # power off after this long empty

# --- Discord bot (all optional; see docs/DISCORD.md) ---
# Empty discord_public_key leaves the interactions endpoint disabled (404).
# discord_public_key     = ""            # Discord app "Public key" (not the bot token)
# discord_guild_id       = ""            # your Discord server ID; empty = any guild the app joined
# discord_admin_role_ids = "111,222"     # roles allowed /paladmin + console-user management
# discord_user_role_ids  = ""            # roles allowed /palworld; empty = every guild member

# --- security / ops (safe defaults; opt in when ready) ---
# panel_allowed_cidrs        = ["0.0.0.0/0"]   # RISK: restrict once coordinator egress path is decided (plan §9)
# ssh_admin_cidrs            = []               # extra CIDRs for the restricted SSH rule (IAP range is always allowed)
# enable_secret_manager      = false           # true = fetch secrets from Secret Manager instead of instance metadata (needs VM recreate)
# enable_monitoring          = true            # uptime check + alert policy on the coordinator
# notification_channel_email = ""              # email for the alert policy; empty = alert exists but nobody is paged
